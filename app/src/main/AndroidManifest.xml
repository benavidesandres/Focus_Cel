<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifiesto principal de la aplicación Focus.
    Declara permisos, actividades y servicios requeridos.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Visibilidad de paquetes (Android 11+): declara solo lo necesario para listar las apps
        lanzables y detectar el launcher y el marcador, sin el permiso sensible QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!--
        FOREGROUND_SERVICE: Requerido para mantener la sesión activa
        cuando la aplicación está en segundo plano.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        POST_NOTIFICATIONS: Requerido en Android 13+ para mostrar notificaciones
        de sesión activa desde el servicio en primer plano.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        VIBRATE: Requerido para proporcionar retroalimentación háptica coordinada con el smartwatch.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        RECEIVE_BOOT_COMPLETED: Permite reconciliar sesiones activas tras reinicio.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".app.FocusApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Focus"
        tools:targetApi="31">

        <!-- Actividad principal de la aplicación -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Focus.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Actividad de restricción mostrada por FocusAccessibilityService
            cuando el usuario intenta abrir una aplicación bloqueada durante una sesión activa.
        -->
        <activity
            android:name=".platform.accessibility.RestrictionActivity"
            android:exported="false"
            android:theme="@style/Theme.Focus"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity="" />

        <!--
            Servicio en primer plano que mantiene viva la sesión con la app cerrada.
            Usa specialUse porque un temporizador de enfoque no encaja en los tipos estándar.
        -->
        <service
            android:name=".platform.session.FocusSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started focus session running: countdown, app blocking and smartwatch sync." />
        </service>

        <!--
            Servicio de accesibilidad para detectar aplicaciones en primer plano
            y mostrar la pantalla de restricción durante sesiones activas.
            El usuario debe habilitarlo manualmente en Ajustes > Accesibilidad.
        -->
        <service
            android:name=".platform.accessibility.FocusAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Servicio para escuchar eventos enviados desde el Smartwatch (Wear OS) -->
        <service
            android:name=".platform.smartwatch.FocusWearableListenerService"
            android:exported="true">
            <!-- Mensajes enviados por la app del reloj -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/focus"
                    android:scheme="wear" />
            </intent-filter>
            <!-- Instalación y alcance de la app Focus en el reloj -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:path="/focus_wear_app"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Receptor para reconciliar sesiones tras reinicio del dispositivo -->
        <receiver
            android:name=".platform.receiver.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
